/*
 * PS/2 Mouse / Trackpoint support for the do52 (nice!nano v2 / nRF52840)
 *
 * Driver: https://github.com/infused-kim/kb_zmk_ps2_mouse_trackpoint_driver
 *
 * This file is included from do52_right.overlay because the RIGHT half is the
 * BLE split central (see Kconfig.defconfig). The PS/2 driver only works on the
 * central half, so the trackpoint MUST be wired to the RIGHT controller.
 *
 * If you move the trackpoint to the LEFT half instead, move the #include to
 * do52_left.overlay AND change ZMK_SPLIT_ROLE_CENTRAL to the left side in
 * Kconfig.defconfig.
 *
 * Pins (nice!nano "pro_micro" numbering), wired to the right controller:
 *   SCL (clock) : D15  (P1.13)
 *   SDA (data)  : D16  (P0.10 -> NRF_PSEL(UART_RX, 0, 10))
 *
 * No hardware reset (Power-On-Reset) pin is wired, so MOUSE_PS2_PIN_RST is not
 * defined. The driver still resets the trackpoint via the PS/2 software reset
 * command over clock/data at boot. If the TP is flaky on startup, wire a third
 * line to a free pin (D3, D10, D14, D18) and define MOUSE_PS2_PIN_RST_PRO_MICRO
 * + add rst-gpios back to the mouse_ps2 node below.
 *
 * Using the UART driver (recommended for nRF52). Baud 14400 matches the
 * ~67us cycle of IBM/Lenovo trackpoints.
 */

#define MOUSE_PS2_DRIVER_UART

#define MOUSE_PS2_PIN_SCL_PRO_MICRO <&pro_micro 15 GPIO_ACTIVE_HIGH>
#define MOUSE_PS2_PIN_SDA_PRO_MICRO <&pro_micro 16 GPIO_ACTIVE_HIGH>

// SDA in pinctrl notation. Must match SDA above. D16 == P0.10 -> 0, 10
#define MOUSE_PS2_PIN_SDA_PINCTRL <NRF_PSEL(UART_RX, 0, 10)>

#define MOUSE_PS2_UART_BAUD_RATE <14400>

// Unexposed nRF52840 UART pins (UART needs two pins; PS/2 only uses one).
// Do NOT change these on a nice!nano v2 / clone.
#define MOUSE_PS2_PIN_UNEXPOSED_TX <NRF_PSEL(UART_TX, 0, 27)>
#define MOUSE_PS2_PIN_UNEXPOSED_RX <NRF_PSEL(UART_RX, 0, 28)>


/*
 * Interrupt priority overrides for the nice!nano v2 (nRF52840).
 *
 * PS/2 events must be serviced within ~30-50us. We give GPIOTE the highest
 * priority and demote everything else by two levels so PS/2 transmissions are
 * reliable. Generated for nice_nano_v2 by the driver's
 * scripts/gen_interrupt_priority_overrides.py.
 */
&gpiote { interrupts = < 6 0 >; };
&clock { interrupts = < 0 3 >; };
&power { interrupts = < 0 3 >; };
&radio { interrupts = < 1 3 >; };
&uart0 { interrupts = < 2 3 >; };
&i2c0 { interrupts = < 3 3 >; };
&spi0 { interrupts = < 3 3 >; };
&i2c1 { interrupts = < 4 3 >; };
&spi1 { interrupts = < 4 3 >; };
&nfct { interrupts = < 5 3 >; };
&adc { interrupts = < 7 3 >; };
&timer0 { interrupts = < 8 3 >; };
&timer1 { interrupts = < 9 3 >; };
&timer2 { interrupts = < 10 3 >; };
&rtc0 { interrupts = < 11 3 >; };
&temp { interrupts = < 12 3 >; };
&rng { interrupts = < 13 3 >; };
&ecb { interrupts = < 14 3 >; };
&ccm { interrupts = < 15 3 >; };
&wdt { interrupts = < 16 3 >; };
&rtc1 { interrupts = < 17 3 >; };
&qdec { interrupts = < 18 3 >; };
&comp { interrupts = < 19 3 >; };
&egu0 { interrupts = < 20 3 >; };
&egu1 { interrupts = < 21 3 >; };
&egu2 { interrupts = < 22 3 >; };
&egu3 { interrupts = < 23 3 >; };
&egu4 { interrupts = < 24 3 >; };
&egu5 { interrupts = < 25 3 >; };
&timer3 { interrupts = < 26 3 >; };
&timer4 { interrupts = < 27 3 >; };
&pwm0 { interrupts = < 28 3 >; };
&pdm0 { interrupts = < 29 3 >; };
&pwm1 { interrupts = < 33 3 >; };
&pwm2 { interrupts = < 34 3 >; };
&spi2 { interrupts = < 35 3 >; };
&rtc2 { interrupts = < 36 3 >; };
&i2s0 { interrupts = < 37 3 >; };
&usbd { interrupts = < 39 3 >; };
&uart1 { interrupts = < 40 3 >; };
&qspi { interrupts = < 41 3 >; };
&pwm3 { interrupts = < 45 3 >; };
&spi3 { interrupts = < 47 3 >; };
&cryptocell { interrupts = < 42 3 >; };


/*
 * PS/2 device tree nodes. Do not edit below unless you know what you're doing.
 */
&pinctrl {
	uart0_ps2_default: uart0_ps2_default {
		group1 {
			psels = MOUSE_PS2_PIN_UNEXPOSED_TX,
					MOUSE_PS2_PIN_SDA_PINCTRL;
		};
	};

	uart0_ps2_sleep: uart0_ps2_sleep {
		group1 {
			psels = MOUSE_PS2_PIN_UNEXPOSED_TX,
					MOUSE_PS2_PIN_SDA_PINCTRL;
			low-power-enable;
		};
	};

	uart0_ps2_off: uart0_ps2_off {
		group1 {
			psels = MOUSE_PS2_PIN_UNEXPOSED_TX,
					MOUSE_PS2_PIN_UNEXPOSED_RX;
		};
	};
};

&uart0 {
	status = "okay";
	compatible = "nordic,nrf-uarte";

	current-speed = MOUSE_PS2_UART_BAUD_RATE;
	pinctrl-0 = <&uart0_ps2_default>;
	pinctrl-1 = <&uart0_ps2_off>;
	pinctrl-names = "default", "sleep";

	uart_ps2: uart_ps2 {
		status = "okay";
		compatible = "uart-ps2";
		scl-gpios = MOUSE_PS2_PIN_SCL_PRO_MICRO;
		sda-gpios = MOUSE_PS2_PIN_SDA_PRO_MICRO;
	};
};

/ {
	mouse_ps2: mouse_ps2 {
		status = "okay";
		compatible = "zmk,input-mouse-ps2";
		ps2-device = <&uart_ps2>;
		// No hardware reset pin wired; the driver uses the PS/2 software reset.
	};

	mouse_ps2_input_listener: mouse_ps2_input_listener {
		status = "okay";
		compatible = "zmk,input-listener-ps2";
		device = <&mouse_ps2>;

		// Uncomment to flip/swap axes if the cursor moves the wrong way:
		// xy-swap;
		// x-invert;
		// y-invert;
	};
};
