# The RIGHT half is the BLE split central. (Carried over from the trackpoint
# era; either half could be central now. Changing it forces a BLE re-pair, so
# leave it unless you have a reason — see `zmk.py reset`.)
if SHIELD_DO52_RIGHT

config ZMK_KEYBOARD_NAME
    default "do52"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_DO52_LEFT || SHIELD_DO52_RIGHT
config ZMK_SPLIT
    default y
endif
